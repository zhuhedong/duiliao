# ==============================================================================
# 对料 (Duiliao) 前端生产环境构建清单 (Frontend .env.production)
# ==============================================================================

# 前端请求防篡改签名秘钥 (必须与后端 APP_SIGNING_SECRET 绝对一致)
VITE_APP_SIGNING_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24

# 生产 API 基础路径
# 如果使用同一域名通过 Nginx 反向代理转发 /api/，此处填写 /api/v1 即可
VITE_API_BASE_URL=/api/v1

# 客户端终端类型标识 (web / ios / android)
VITE_APP_ID=web
