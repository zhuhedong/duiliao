# Copy to .env.local. Vite exposes only VITE_-prefixed vars to the client.

# Base URL of the API. Empty -> use the dev proxy in vite.config.ts (/api/v1).
VITE_API_BASE_URL=

# Must match backend APP_SIGNING_SECRET. NOTE: anything shipped to a browser or
# app bundle is inspectable; this is an integrity/anti-tamper layer, not a
# secret between you and the user. Rotate per client release.
VITE_APP_SIGNING_SECRET=CHANGE_ME_app_signing_secret_change_me

# Identifies the client build to the server (useful once you ship an app).
VITE_APP_ID=web
