# ==============================================================================
# 对料 (Duiliao) 生产环境配置清单 (Production .env)
# ==============================================================================

# --- 基础运行模式 ---
APP_NAME="Duiliao API"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# --- 生产数据库 (PostgreSQL 推荐) ---
# 注意：若使用 PostgreSQL，驱动为 postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://duiliao_user:YourStrongPassword@127.0.0.1:5432/duiliao_app
COLLECTOR_DATABASE_URL=postgresql+psycopg://duiliao_user:YourStrongPassword@127.0.0.1:5432/duiliao_collector
MAX_UPLOAD_SIZE_MB=100

# --- 生产允许跨域域名 (以英文逗号分隔) ---
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,capacitor://localhost,http://localhost

# --- JWT 鉴权凭证 ---
# 使用命令生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 端到端加密与签名安全 (核心) ---
# 必须与前端 VITE_APP_SIGNING_SECRET 绝对一致！
# 使用命令生成：openssl rand -hex 24
APP_SIGNING_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24
ENFORCE_REQUEST_SIGNATURE=true
REQUEST_TIMESTAMP_TOLERANCE_SECONDS=300
SESSION_KEY_TTL_SECONDS=3600
RSA_KEY_SIZE=2048

# 生产环境稳定的 RSA 私钥（单行带 \n 或多行 PEM 均可）
# 使用命令生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out rsa_private.pem
RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# --- 生产权限开关 ---
# 生产环境必须关闭匿名初次初始化引导！
ALLOW_LOCAL_BOOTSTRAP=false
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- 大语言模型 AI 研判服务商 (可选) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
