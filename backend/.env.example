# Copy to .env and fill in real values. NEVER commit .env.

APP_NAME="Duiliao API"
APP_ENV=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (dev default is local SQLite). For prod use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/duiliao
DATABASE_URL=sqlite:///./duiliao.db

# CORS: comma-separated origins (web dev server + Capacitor app schemes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# JWT  (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=CHANGE_ME_super_secret_key_min_32_chars_long_0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# API transport encryption. Leave RSA_PRIVATE_KEY_PEM empty in dev to auto-gen
# (it will be printed once so you can pin it). In prod, ALWAYS set a stable key.
RSA_PRIVATE_KEY_PEM=
RSA_KEY_SIZE=2048
SESSION_KEY_TTL_SECONDS=3600

# Request signing / anti-replay (ship APP_SIGNING_SECRET baked into clients)
APP_SIGNING_SECRET=CHANGE_ME_app_signing_secret_change_me
REQUEST_TIMESTAMP_TOLERANCE_SECONDS=300
ENFORCE_REQUEST_SIGNATURE=true

# Rate limits
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# Password policy
PASSWORD_MIN_LENGTH=8

# First-run admin bootstrap
# ALLOW_LOCAL_BOOTSTRAP=true

# Collector Database
# COLLECTOR_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/collector_db

# AI Model Configuration
AI_DEFAULT_PROVIDER=openai     # openai | gemini | anthropic

# OpenAI / DeepSeek / Qwen / Kimi
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

